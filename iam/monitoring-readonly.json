{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MonitoringModuleReadOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "ec2:DescribeInstances",
        "ec2:DescribeRegions",
        "rds:DescribeDBInstances",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:ListBucketMetricsConfigurations",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
