# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# SSO / Identity Center users (e.g. Google login to AWS):
#   1. Open your AWS access portal (the same start URL you log in with).
#   2. Expand your account -> "Command line or programmatic access".
#   3. Copy all THREE values below. They expire with your SSO session
#      (typically 8-12h) — just re-copy when the dashboard reports expired credentials.
#
# IAM-user users (if you ever get one): same file, leave AWS_SESSION_TOKEN empty.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1
