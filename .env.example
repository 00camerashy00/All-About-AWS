# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# SSO / Identity Center users (e.g. Google login to AWS):
#   1. Open your AWS access portal (the same start URL you log in with).
#   2. Expand your account -> "Command line or programmatic access".
#   3. Copy all THREE values below. They expire with your SSO session
#      (typically 8-12h) — just re-copy when the dashboard reports expired credentials.
#
# IAM-user users (if you ever get one): same file, leave AWS_SESSION_TOKEN empty.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1

# Attention email (AAA). Sent only after a live Resources scan that finds a
# server or database disk at or above 80%, an enabled auto-scaling group or
# a member instance, or an under- or over-provisioned server or database.
# The scan still succeeds when mail cannot be sent. Do not put secrets here.
# ALERT_EMAIL_TO defaults to its@krishagni.com when this is left empty.
ALERT_EMAIL_TO=its@krishagni.com
# Verified Amazon SES sender. Mail is skipped until this is set.
ALERT_EMAIL_FROM=
# SES region. Defaults to AWS_REGION when empty.
ALERT_EMAIL_REGION=

# Secure Link Generator. Defaults match scripts/client_data_ingress.py.
# The bucket region is used to sign the upload, separate from AWS_REGION.
INGRESS_BUCKET=krishagni-client-ingress
INGRESS_REGION=us-west-2